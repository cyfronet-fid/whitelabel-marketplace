### Rails secret key base - MANDATORY
### ---------------------------------------------------------------------------
SECRET_KEY_BASE=random-secret-key-base

### Storage directory - MANDATORY
### ---------------------------------------------------------------------------
STORAGE_DIR=/marketplace/media

### Your domain name - MANDATORY
### ---------------------------------------------------------------------------
ROOT_URL=http://testhost

### Database configuration - MANDATORY
### ---------------------------------------------------------------------------
# DATABASE_URL=postgres://mpuser:mppass@db/mp
DISABLE_DATABASE_ENVIRONMENT_CHECK=1
RAILS_SERVE_STATIC_FILES=1
# ELASTICSEARCH_URL=el
# REDIS_URL=redis://redis:6379/0

### Checkin (Keycloak) envs - MANDATORY
### ---------------------------------------------------------------------------
CHECKIN_HOST=keyclock.testhost
CHECKIN_ISSUER_URI=https://keyclock.testhost/realms/core
CHECKIN_SCOPE=basic,profile,email,offline_access
CHECKIN_DISCOVERY=true
CHECKIN_PKCE=false
CHECKIN_IDENTIFIER=identifier
CHECKIN_SECRET=secret
REDIRECT_URI=http://testhost/users/auth/checkin/callback

### Checkin (Keycloak) envs - MANDATORY if CHECKIN_DISCOVERY is false
### ---------------------------------------------------------------------------
# CHECKIN_AUTHORIZATION_ENDPOINT=/realms/core/protocol/openid-connect/auth
# CHECKIN_TOKEN_ENDPOINT=/realms/core/protocol/openid-connect/token
# CHECKIN_USERINFO_ENDPOINT=/realms/core/protocol/openid-connect/userinfo
# CHECKIN_JWKS_URI=/realms/core/protocol/openid-connect/certs
# CHECKIN_END_SESSION_ENDPOINT=/realms/core/protocol/openid-connect/logout

### Service Catalog import - envs should be obtained according to the instructions from Nicolas
### ---------------------------------------------------------------------------
# MP_IMPORT_EOSC_REGISTRY_URL=https://<YOUR_SERVICE_CATALOG_HOST>/api
# IMPORT_CLIENT_ID=<YOUR_IDENTIFIER>
# IMPORT_CLIENT_SECRET=<YOUR_SECRET>

### SMTP configuration - MANDATORY
### ---------------------------------------------------------------------------
SMTP_ADDRESS=smtp.testhost
SMTP_USERNAME=username
SMTP_PASSWORD=password
FROM_EMAIL=from@testhost

### Asset host configuration - MANDATORY
### ---------------------------------------------------------------------------
ASSET_HOST=testhost
ASSET_PROTOCOL=https

